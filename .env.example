# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543).
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=

# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://mrnyhnwxbfcbdvgdafgm.supabase.co
# Chave secreta (sb_secret_…). Só no servidor — nunca use NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=

# Análise de verificação por IA (Claude). Sem chave, o analisador por regras é usado.
ANTHROPIC_API_KEY=
# "off" desliga a IA mesmo com chave configurada.
VERIFICATION_AI=on
